{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@moneda/shared": ["./packages/shared/src/index.ts"],
      "@moneda/shared/*": ["./packages/shared/src/*"],
      "@moneda/ui-tokens": ["./packages/ui-tokens/src/index.ts"],
      "@moneda/ui-tokens/*": ["./packages/ui-tokens/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "packages/shared/src/**/*.ts",
    "packages/shared/src/**/*.tsx",
    "packages/ui-tokens/src/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "apps"
  ]
}
