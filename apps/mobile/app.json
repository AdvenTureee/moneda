{
  "expo": {
    "name": "Moneda",
    "slug": "moneda",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "moneda",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#5BBF8E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.moneda.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Para registrar gastos por áudio no Moneda."
      }
    },
    "android": {
      "package": "app.moneda.mobile",
      "permissions": ["RECORD_AUDIO", "INTERNET"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        { "faceIDEnabled": false }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
