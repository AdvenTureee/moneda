# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
screenshots/
mo-icons
# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase cli temp
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# monorepo — apps/mobile (Expo / React Native)
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/.metro-cache/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/node_modules/
# Mantém .env.example versionado, ignora .env real (com chaves públicas/privadas).
apps/mobile/.env

# monorepo — packages (shared libraries)
packages/*/dist/
packages/*/build/
packages/*/node_modules/
packages/*/*.tsbuildinfo
